        <Param val="import * as np from 'numpy';&amp;#10;if ((practSymResponse_yes.isClicked || practSymResponse_no.isClicked)) {&amp;#10;    if ((sequenceDataset_practSym.symmetry[practiceSymBlock.thisN] === 1)) {&amp;#10;        sequenceDataset_practSym.Accuracy[practiceSymBlock.thisN] = Number.parseInt(practSymResponse_yes.isClicked);&amp;#10;    } else {&amp;#10;        sequenceDataset_practSym.Accuracy[practiceSymBlock.thisN] = Number.parseInt(practSymResponse_no.isClicked);&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPractSym.Accuracy&quot;, sequenceDataset_practSym.Accuracy[practiceSymBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
