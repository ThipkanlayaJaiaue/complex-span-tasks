        <Param val="import * as np from 'numpy';&amp;#10;PracticeRed_allTrials_num = sequenceDataset_practFinal.Accuracy_red.length;&amp;#10;PracticeRed_correctTrials_num = np.sum(sequenceDataset_practFinal.Accuracy_red);&amp;#10;PracticeFinalSym_allTrials_num = sequenceDataset_practFinal.Accuracy_sym.length;&amp;#10;PracticeFinalSym_correctTrials_num = np.sum(sequenceDataset_practFinal.Accuracy_sym);&amp;#10;PracticeFinalSym_speedError_num = np.sum(sequenceDataset_practFinal.error_speed);&amp;#10;PracticeFinalSym_accuracyError_num = np.sum(sequenceDataset_practFinal.error_sym);&amp;#10;msg = `${PracticeFinalSym_correctTrials_num} of ${PracticeFinalSym_allTrials_num} correct judgments&amp;#10;(${PracticeFinalSym_speedError_num} delayed judgments)&amp;#10;&amp;#10;${PracticeRed_correctTrials_num} of ${PracticeRed_allTrials_num}`&amp;#10;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
