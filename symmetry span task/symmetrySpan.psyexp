        <Param val="import * as random from 'random';&amp;#10;import * as np from 'numpy';&amp;#10;import * as pd from 'pandas';&amp;#10;setSizes_pool = [2, 2, 3];&amp;#10;Math.random.shuffle(setSizes_pool);&amp;#10;setSizes_num = setSizes_pool.length;&amp;#10;setSizes_block_num = np.arange(1, (setSizes_num + 1));&amp;#10;setSizes_practFinal = new pd.DataFrame({&quot;setSizes_block_num&quot;: setSizes_block_num, &quot;current_setSize&quot;: setSizes_pool});&amp;#10;setSizes_practFinal;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="import random&amp;#10;import numpy as np&amp;#10;import pandas as pd&amp;#10;&amp;#10;# define and shuffle the set-size&amp;#10;setSizes_pool = [2,2,3]&amp;#10;random.shuffle(setSizes_pool)&amp;#10;&amp;#10;# count the total number of set-size&amp;#10;setSizes_num = len(setSizes_pool)&amp;#10;&amp;#10;# create block number column&amp;#10;setSizes_block_num = np.arange(1, setSizes_num + 1)&amp;#10;&amp;#10;# create a DataFrame from the shuffled pool&amp;#10;setSizes_practFinal = pd.DataFrame({&amp;#10;    'setSizes_block_num': setSizes_block_num,&amp;#10;    'current_setSize': setSizes_pool&amp;#10;&amp;#10;})&amp;#10;&amp;#10;setSizes_practFinal" valType="extendedCode" updates="constant" name="End Routine"/>
