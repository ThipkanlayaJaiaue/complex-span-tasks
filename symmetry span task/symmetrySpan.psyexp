        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((sequenceDataset.error_speed[experimentalBlock.thisN] === 0)) {&amp;#10;    if ((sequenceDataset.symmetry[experimentalBlock.thisN] === 1)) {&amp;#10;        sequenceDataset.Accuracy_sym[experimentalBlock.thisN] = yes.numClicks;&amp;#10;    } else {&amp;#10;        sequenceDataset.Accuracy_sym[experimentalBlock.thisN] = no.numClicks;&amp;#10;    }&amp;#10;} else {&amp;#10;    sequenceDataset.Accuracy_sym[experimentalBlock.thisN] = 0;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.Accuracy_sym&quot;, sequenceDataset.Accuracy_sym[experimentalBlock.thisN]);&amp;#10;if ((sequenceDataset.symmetry[experimentalBlock.thisN] === 1)) {&amp;#10;    sequenceDataset.error_sym[experimentalBlock.thisN] = no.numClicks;&amp;#10;} else {&amp;#10;    sequenceDataset.error_sym[experimentalBlock.thisN] = yes.numClicks;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.error_sym&quot;, sequenceDataset.error_sym[experimentalBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# accuracy sym (overall accuracy, this will be 0 if participants take too long to respond)&amp;#10;if sequenceDataset.error_speed[experimentalBlock.thisN] == 0:&amp;#10;    if sequenceDataset.symmetry[experimentalBlock.thisN] == 1:&amp;#10;        sequenceDataset.Accuracy_sym[experimentalBlock.thisN]             = yes.numClicks &amp;#10;    else:&amp;#10;        sequenceDataset.Accuracy_sym[experimentalBlock.thisN]             = no.numClicks&amp;#10;else:&amp;#10;    sequenceDataset.Accuracy_sym[experimentalBlock.thisN] = 0&amp;#10;thisExp.addData('myExp.Accuracy_sym',         sequenceDataset.Accuracy_sym[experimentalBlock.thisN])&amp;#10;&amp;#10;# judgement error (pure error from judgement, don't care whether pt take too long to judge the grid)&amp;#10;if sequenceDataset.symmetry[experimentalBlock.thisN] == 1:&amp;#10;    sequenceDataset.error_sym[experimentalBlock.thisN]                   = no.numClicks&amp;#10;else:&amp;#10;    sequenceDataset.error_sym[experimentalBlock.thisN]                   = yes.numClicks&amp;#10;thisExp.addData('myExp.error_sym', sequenceDataset.error_sym[experimentalBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expResponse_addData" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
