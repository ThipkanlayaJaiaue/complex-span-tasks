      <CodeComponent name="practSquareRecall_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="practSquareRecall_next.setAutoDraw(false);&amp;#10;last_clicked_button = null;&amp;#10;buttons = [button1_pract_2, button2_pract_2, button3_pract_2, button4_pract_2, button5_pract_2, button6_pract_2, button7_pract_2, button8_pract_2, button9_pract_2, button10_pract_2, button11_pract_2, button12_pract_2, button13_pract_2, button14_pract_2, button15_pract_2, button16_pract_2];&amp;#10;psychoJS.experiment.addData(&quot;myPractRedSquare.expectedRedSquare_num&quot;, sequenceDataset_practRedSquare.redSquare_num[practiceRedSquareRecallBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="practSquareRecall_next.setAutoDraw(False)&amp;#10;&amp;#10;# set a variable to keep track of the last clicked button &amp;#10;last_clicked_button = None&amp;#10;&amp;#10;buttons = [button1_pract_2, button2_pract_2, button3_pract_2, button4_pract_2, button5_pract_2, button6_pract_2, &amp;#10;           button7_pract_2, button8_pract_2, button9_pract_2, button10_pract_2, button11_pract_2, button12_pract_2, &amp;#10;           button13_pract_2, button14_pract_2, button15_pract_2, button16_pract_2]&amp;#10;&amp;#10;# copy the red square to this line for future accuracy check&amp;#10;thisExp.addData('myPractRedSquare.expectedRedSquare_num',           sequenceDataset_practRedSquare.redSquare_num[practiceRedSquareRecallBlock.thisN])&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# deal with button color after click, and 'next' button&amp;#10;for button in buttons:&amp;#10;    if button.isClicked:  # when a button is clicked&amp;#10;        if last_clicked_button is not None:  # if that button was already clicked before&amp;#10;            last_clicked_button.fillColor = 'white'  # reset the previous clicked button to white&amp;#10;        button.fillColor = 'red'  # this current button now turn to red&amp;#10;        last_clicked_button = button  # store last clicked button&amp;#10;        practSquareRecall_next.setAutoDraw(True) # 'next' button pop up&amp;#10;        &amp;#10;        # set a variable to store the selected red square number and accuracy&amp;#10;        button_number = int(last_clicked_button.name.split('button')[1].split('_')[0])&amp;#10;        thisExp.addData('myPractRedSquare.selected_button', button_number)&amp;#10;        sequenceDataset_practRedSquare.Accuracy[practiceRedSquareRecallBlock.thisN]             = int(sequenceDataset_practRedSquare.redSquare_num[practiceRedSquareRecallBlock.thisN] == button_number)&amp;#10;        thisExp.addData('myPractRedSquare.Accuracy',      sequenceDataset_practRedSquare.Accuracy[practiceRedSquareRecallBlock.thisN])&amp;#10;        break&amp;#10;&amp;#10;if practSquareRecall_next.isClicked:&amp;#10;    for last_clicked_button in buttons:&amp;#10;        last_clicked_button.fillColor = 'white' # reset them all to white after click 'next'&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="for (var button, _pj_c = 0, _pj_a = buttons, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    button = _pj_a[_pj_c];&amp;#10;    if (button.isClicked) {&amp;#10;        if ((last_clicked_button !== null)) {&amp;#10;            last_clicked_button.fillColor = &quot;white&quot;;&amp;#10;        }&amp;#10;        button.fillColor = &quot;red&quot;;&amp;#10;        last_clicked_button = button;&amp;#10;        practSquareRecall_next.setAutoDraw(true);&amp;#10;        button_number = Number.parseInt(last_clicked_button.name.split(&quot;button&quot;)[1].split(&quot;_&quot;)[0]);&amp;#10;        psychoJS.experiment.addData(&quot;myPractRedSquare.selected_button&quot;, button_number);&amp;#10;        sequenceDataset_practRedSquare.Accuracy[practiceRedSquareRecallBlock.thisN] = Number.parseInt((sequenceDataset_practRedSquare.redSquare_num[practiceRedSquareRecallBlock.thisN] === button_number));&amp;#10;        psychoJS.experiment.addData(&quot;myPractRedSquare.Accuracy&quot;, sequenceDataset_practRedSquare.Accuracy[practiceRedSquareRecallBlock.thisN]);&amp;#10;        break;&amp;#10;    }&amp;#10;}&amp;#10;if (practSquareRecall_next.isClicked) {&amp;#10;    for (var last_clicked_button, _pj_c = 0, _pj_a = buttons, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        last_clicked_button = _pj_a[_pj_c];&amp;#10;        last_clicked_button.fillColor = &quot;white&quot;;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="practSquareRecall_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
