      <CodeComponent name="practFinal_sequenceGeneration2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;PractSetUp.setSizes_block_num&quot;, setSizes_practFinal.setSizes_block_num[AllPracticeBlocks.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;PractSetUp.current_setSize&quot;, setSizes_practFinal.current_setSize[AllPracticeBlocks.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# add data about the sequence&amp;#10;thisExp.addData('PractSetUp.setSizes_block_num',           setSizes_practFinal.setSizes_block_num[AllPracticeBlocks.thisN])&amp;#10;thisExp.addData('PractSetUp.current_setSize',            setSizes_practFinal.current_setSize[AllPracticeBlocks.thisN])" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="import numpy as np&amp;#10;import pandas as pd&amp;#10;&amp;#10;trialAll_num = setSizes_practFinal.current_setSize[AllPracticeBlocks.thisN]  # number of trials (must be even)&amp;#10;category = [&quot;sym&quot;, &quot;asym&quot;]&amp;#10;sym_number = range(1, 8)&amp;#10;asym_number = range(1,9)&amp;#10;red_number = range(1, 17) # there are 16 choices for red square&amp;#10;&amp;#10;# create variable 'trial'&amp;#10;trial = 1 + np.arange(0, trialAll_num)&amp;#10;&amp;#10;# create variables 'figName and symmetry'&amp;#10;figName = np.empty(trialAll_num, dtype=&quot;&lt;U11&quot;)&amp;#10;symmetry = np.empty(trialAll_num, dtype=int)&amp;#10;redSquare_figName = np.empty(trialAll_num, dtype=&quot;&lt;U12&quot;)&amp;#10;redSquare_num = np.empty(trialAll_num, dtype=int)&amp;#10;&amp;#10;# create all possible figure and arrow names&amp;#10;all_fig_names = [f&quot;pract_{c}{n}&quot; for c in category for n in (asym_number if c == 'asym' else sym_number)]&amp;#10;all_redSquare_names = [f&quot;red_square{rn}&quot; for rn in red_number]&amp;#10;&amp;#10;&amp;#10;# create a while loop to run until conditions are met&amp;#10;while True:&amp;#10;    # shuffle the possible figure and arrow names&amp;#10;    np.random.shuffle(all_fig_names)&amp;#10;    np.random.shuffle(all_redSquare_names)&amp;#10;    &amp;#10;    # used the first-trialAll_num index from each list&amp;#10;    used_fig_names = all_fig_names[:trialAll_num]&amp;#10;    used_redSquare_names = all_redSquare_names[:trialAll_num]&amp;#10;&amp;#10;    for trialIdx in range(trialAll_num):&amp;#10;        figName[trialIdx] = used_fig_names[trialIdx]&amp;#10;        &amp;#10;        # add 1 or 0 in 'symmetry' based on &quot;sym&quot; or &quot;asym&quot; in the figure name&amp;#10;        symmetry[trialIdx] = 0 if &quot;asym&quot; in figName[trialIdx] else 1&amp;#10;        redSquare_figName[trialIdx] = used_redSquare_names[trialIdx]&amp;#10;        # extract the number from the red square name&amp;#10;        redSquare_num[trialIdx] = int(redSquare_figName[trialIdx].split('red_square')[-1])&amp;#10;&amp;#10;    # create variables to calculate face forward/mirror reversed figure proportions&amp;#10;    sym_proportion = np.sum(symmetry == 1) / trialAll_num&amp;#10;    asym_proportion = np.sum(symmetry == 0) / trialAll_num&amp;#10;&amp;#10;    # check if both proportions are at least 30%&amp;#10;    if sym_proportion &gt;= 0.30 and asym_proportion &gt;= 0.30:&amp;#10;        break  # exit the loop when the condition are met&amp;#10;&amp;#10;# create a DataFrame for the sequence dataset&amp;#10;sequenceDataset_practFinal = pd.DataFrame({&amp;#10;    'trial': trial,&amp;#10;    'symmetry': symmetry,&amp;#10;    'pract_figName': figName,&amp;#10;    'red_square_figName': redSquare_figName,&amp;#10;    'redSquare_num': redSquare_num,&amp;#10;    'expectedResponse': np.nan,&amp;#10;    'observedResponse': np.nan,&amp;#10;    'Accuracy_sym': np.nan,&amp;#10;    'Accuracy_red': np.nan,&amp;#10;    'error_sym': np.nan,&amp;#10;    'error_speed': np.nan,&amp;#10;    'trialDuration': np.nan&amp;#10;})&amp;#10;&amp;#10;sequenceDataset_practFinal" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="practFinal_sequenceGeneration2" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
