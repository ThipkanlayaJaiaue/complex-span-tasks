        <Param val="import * as np from 'numpy';&amp;#10;PracticeRS_allTrials_num = sequenceDataset_practRedSquare.Accuracy.length;&amp;#10;PracticeRS_correctTrials_num = np.sum(sequenceDataset_practRedSquare.Accuracy);&amp;#10;msg = `${PracticeRS_correctTrials_num} of ${PracticeRS_allTrials_num}`;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
