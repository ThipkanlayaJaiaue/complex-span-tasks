      <CodeComponent name="practSym_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;myPractSym.trial&quot;, sequenceDataset_practSym.trial[practiceSymBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myPractSym.figName&quot;, sequenceDataset_practSym.figName[practiceSymBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myPractSym.symmetry&quot;, sequenceDataset_practSym.symmetry[practiceSymBlock.thisN]);&amp;#10;practSym_next_startTime = null;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# add data&amp;#10;thisExp.addData('myPractSym.trial',            sequenceDataset_practSym.trial[practiceSymBlock.thisN])&amp;#10;thisExp.addData('myPractSym.figName',            sequenceDataset_practSym.figName[practiceSymBlock.thisN])&amp;#10;thisExp.addData('myPractSym.symmetry',           sequenceDataset_practSym.symmetry[practiceSymBlock.thisN])&amp;#10;&amp;#10;# initialise the start time variable&amp;#10;practSym_next_startTime = None  # Will be set when the button is drawn&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# check if the button is being drawn for the first time&amp;#10;if practSym_next_startTime is None and practSym_next.status == STARTED:&amp;#10;    practSym_next_startTime = core.getTime()  # get the time when the button first appears&amp;#10;    thisExp.addData('practSym_next.started', practSym_next_startTime)  # add the start time&amp;#10;&amp;#10;# check if the button is clicked&amp;#10;if practSym_next.isClicked:&amp;#10;    if not practSym_next.timesOn:  # if the list is empty&amp;#10;        practSym_next.timesOn.append(core.getTime())  # manually store the press time&amp;#10;    button_press_time = practSym_next.timesOn[-1]&amp;#10;    # save the button press time and calculate the duration&amp;#10;    thisExp.addData('practSym_next.pressed', button_press_time)&amp;#10;&amp;#10;    # calculate duration&amp;#10;    sequenceDataset_practSym.trialDuration[practiceSymBlock.thisN] = button_press_time - practSym_next_startTime&amp;#10;    thisExp.addData('myPractSym.trialDuration', sequenceDataset_practSym.trialDuration[practiceSymBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((practSym_next_startTime === null) &amp;&amp; (practSym_next.status === PsychoJS.Status.STARTED))) {&amp;#10;    practSym_next_startTime = core.getTime();&amp;#10;    psychoJS.experiment.addData(&quot;practSym_next.started&quot;, practSym_next_startTime);&amp;#10;}&amp;#10;if (practSym_next.isClicked) {&amp;#10;    if ((! practSym_next.timesOn)) {&amp;#10;        practSym_next.timesOn.push(core.getTime());&amp;#10;    }&amp;#10;    button_press_time = practSym_next.timesOn.slice((- 1))[0];&amp;#10;    psychoJS.experiment.addData(&quot;practSym_next.pressed&quot;, button_press_time);&amp;#10;    sequenceDataset_practSym.trialDuration[practiceSymBlock.thisN] = (button_press_time - practSym_next_startTime);&amp;#10;    psychoJS.experiment.addData(&quot;myPractSym.trialDuration&quot;, sequenceDataset_practSym.trialDuration[practiceSymBlock.thisN]);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
