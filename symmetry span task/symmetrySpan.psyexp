      <CodeComponent name="expRecall_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="expRecall_next.setAutoDraw(False)&amp;#10;&amp;#10;# set a variable to keep track of the last clicked button &amp;#10;last_clicked_button = None&amp;#10;&amp;#10;buttons = [button1, button2, button3, button4, button5, button6, &amp;#10;           button7, button8, button9, button10, button11, button12, &amp;#10;           button13, button14, button15, button16]&amp;#10;        &amp;#10;# copy the red square to this line for future accuracy check&amp;#10;thisExp.addData('myExp.expectedRedSquare_num',           sequenceDataset.redSquare_num[experimentalRecallBlock.thisN])&amp;#10;&amp;#10;&amp;#10;# number of sym trials&amp;#10;ExpSym_allTrials_num = len(sequenceDataset.Accuracy_sym) &amp;#10;# number of correct sym trials &amp;#10;ExpSym_correctTrials_num = np.sum(sequenceDataset.Accuracy_sym)&amp;#10;# percentage of correct sym trials&amp;#10;ExpSym_correctTrials_pct = 100 * ExpSym_correctTrials_num/ExpSym_allTrials_num&amp;#10;# total speed_error&amp;#10;ExpSym_speedError_num = np.sum(sequenceDataset.error_speed)&amp;#10;#total sym_error&amp;#10;ExpSym_accuracyError_num = np.sum(sequenceDataset.error_sym)&amp;#10;&amp;#10;# message for feedback&amp;#10;msg = &quot;%.2f%% correct judgments&quot; %(ExpSym_correctTrials_pct)&amp;#10;  &amp;#10;# color of feedback&amp;#10;if ExpSym_correctTrials_pct&gt;=85:&amp;#10;    fb_col = 'green'     # if accuracy is at least the value above&amp;#10;else:&amp;#10;    fb_col = 'red'" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# deal with button color after click, and 'next' button&amp;#10;for button in buttons:&amp;#10;    if button.isClicked:  # when a button is clicked&amp;#10;        if last_clicked_button is not None:  # if that button was already clicked before&amp;#10;            last_clicked_button.fillColor = 'white'  # reset the previous clicked button to white&amp;#10;        button.fillColor = 'red'  # this current button now turn to red&amp;#10;        last_clicked_button = button  # store last clicked button&amp;#10;        expRecall_next.setAutoDraw(True) # 'next' button pop up&amp;#10;        &amp;#10;        # set a variable to store the selected red square number and accuracy&amp;#10;        button_number = int(last_clicked_button.name.split('button')[1].split('_')[0])&amp;#10;        thisExp.addData('myExp.selected_button', button_number)&amp;#10;        sequenceDataset.Accuracy_red[experimentalRecallBlock.thisN]             = int(sequenceDataset.redSquare_num[experimentalRecallBlock.thisN] == button_number)&amp;#10;        thisExp.addData('myExp.Accuracy_red',      sequenceDataset.Accuracy_red[experimentalRecallBlock.thisN])&amp;#10;        break&amp;#10;&amp;#10;if expRecall_next.isClicked:&amp;#10;    for last_clicked_button in buttons:&amp;#10;        last_clicked_button.fillColor = 'white' # reset them all to white after click 'next'&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="for (var button, _pj_c = 0, _pj_a = buttons, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    button = _pj_a[_pj_c];&amp;#10;    if (button.isClicked) {&amp;#10;        if ((last_clicked_button !== null)) {&amp;#10;            last_clicked_button.fillColor = &quot;white&quot;;&amp;#10;        }&amp;#10;        button.fillColor = &quot;red&quot;;&amp;#10;        last_clicked_button = button;&amp;#10;        expRecall_next.setAutoDraw(true);&amp;#10;        button_number = Number.parseInt(last_clicked_button.name.split(&quot;button&quot;)[1].split(&quot;_&quot;)[0]);&amp;#10;        psychoJS.experiment.addData(&quot;myExp.selected_button&quot;, button_number);&amp;#10;        sequenceDataset.Accuracy_red[experimentalRecallBlock.thisN] = Number.parseInt((sequenceDataset.redSquare_num[experimentalRecallBlock.thisN] === button_number));&amp;#10;        psychoJS.experiment.addData(&quot;myExp.Accuracy_red&quot;, sequenceDataset.Accuracy_red[experimentalRecallBlock.thisN]);&amp;#10;        break;&amp;#10;    }&amp;#10;}&amp;#10;if (expRecall_next.isClicked) {&amp;#10;    for (var last_clicked_button, _pj_c = 0, _pj_a = buttons, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        last_clicked_button = _pj_a[_pj_c];&amp;#10;        last_clicked_button.fillColor = &quot;white&quot;;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expRecall_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
