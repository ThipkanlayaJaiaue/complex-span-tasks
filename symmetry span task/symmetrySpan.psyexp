        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((sequenceDataset_practFinal.error_speed[practiceBlock.thisN] === 0)) {&amp;#10;    if ((sequenceDataset_practFinal.symmetry[practiceBlock.thisN] === 1)) {&amp;#10;        sequenceDataset_practFinal.Accuracy_sym[practiceBlock.thisN] = practFinalResponse_yes.numClicks;&amp;#10;    } else {&amp;#10;        sequenceDataset_practFinal.Accuracy_sym[practiceBlock.thisN] = practFinalResponse_no.numClicks;&amp;#10;    }&amp;#10;} else {&amp;#10;    sequenceDataset_practFinal.Accuracy_sym[practiceBlock.thisN] = 0;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPractFinal.Accuracy_sym&quot;, sequenceDataset_practFinal.Accuracy_sym[practiceBlock.thisN]);&amp;#10;if ((sequenceDataset_practFinal.symmetry[practiceBlock.thisN] === 1)) {&amp;#10;    sequenceDataset_practFinal.error_sym[practiceBlock.thisN] = practFinalResponse_no.numClicks;&amp;#10;} else {&amp;#10;    sequenceDataset_practFinal.error_sym[practiceBlock.thisN] = practFinalResponse_yes.numClicks;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPractFinal.error_sym&quot;, sequenceDataset_practFinal.error_sym[practiceBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# accuracy sym (overall accuracy, this will be 0 if participants take too long to respond)&amp;#10;if sequenceDataset_practFinal.error_speed[practiceBlock.thisN] == 0:&amp;#10;    if sequenceDataset_practFinal.symmetry[practiceBlock.thisN] == 1:&amp;#10;        sequenceDataset_practFinal.Accuracy_sym[practiceBlock.thisN]             = practFinalResponse_yes.numClicks &amp;#10;    else:&amp;#10;        sequenceDataset_practFinal.Accuracy_sym[practiceBlock.thisN]             = practFinalResponse_no.numClicks&amp;#10;else:&amp;#10;    sequenceDataset_practFinal.Accuracy_sym[practiceBlock.thisN] = 0&amp;#10;thisExp.addData('myPractFinal.Accuracy_sym',         sequenceDataset_practFinal.Accuracy_sym[practiceBlock.thisN])&amp;#10;&amp;#10;# judgement error (pure error from judgement, don't care whether pt take too long to judge the grid)&amp;#10;if sequenceDataset_practFinal.symmetry[practiceBlock.thisN] == 1:&amp;#10;    sequenceDataset_practFinal.error_sym[practiceBlock.thisN] = practFinalResponse_no.numClicks&amp;#10;else:&amp;#10;    sequenceDataset_practFinal.error_sym[practiceBlock.thisN] = practFinalResponse_yes.numClicks &amp;#10;thisExp.addData('myPractFinal.error_sym', sequenceDataset_practFinal.error_sym[practiceBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="practFinalResponse_addData" valType="code" updates="None" name="name"/>
