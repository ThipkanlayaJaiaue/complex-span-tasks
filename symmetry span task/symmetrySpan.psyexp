        <Param val="import numpy as np&amp;#10;import pandas as pd&amp;#10;&amp;#10;trialAll_num = 15  # number of trials (must be even)&amp;#10;category = [&quot;sym&quot;, &quot;asym&quot;]&amp;#10;sym_number = range(1, 8)&amp;#10;asym_number = range(1,9)&amp;#10;&amp;#10;# create variable 'trial'&amp;#10;trial = 1 + np.arange(0, trialAll_num)&amp;#10;&amp;#10;# create variables 'figName and symmetry'&amp;#10;figName = np.empty(trialAll_num, dtype=&quot;&lt;U10&quot;)&amp;#10;symmetry = np.empty(trialAll_num, dtype=int)&amp;#10;&amp;#10;# create all possible figure and arrow names&amp;#10;all_fig_names = [f&quot;pract_{c}{n}&quot; for c in category for n in (asym_number if c == 'asym' else sym_number)]&amp;#10;&amp;#10;np.random.shuffle(all_fig_names)&amp;#10;# assign shuffled names to figName and determine symmetry&amp;#10;figName = np.array(all_fig_names[:trialAll_num])&amp;#10;symmetry = np.array([0 if &quot;asym&quot; in name else 1 for name in figName])&amp;#10;&amp;#10;# create a DataFrame&amp;#10;sequenceDataset_practSym = pd.DataFrame({&amp;#10;    'trial': trial,&amp;#10;    'symmetry': symmetry,&amp;#10;    'figName': figName,&amp;#10;    'expectedResponse': np.nan,&amp;#10;    'observedResponse': np.nan,&amp;#10;    'Accuracy': np.nan,&amp;#10;    'trialDuration': np.nan&amp;#10;})&amp;#10;&amp;#10;sequenceDataset_practSym" valType="extendedCode" updates="constant" name="End Routine"/>
