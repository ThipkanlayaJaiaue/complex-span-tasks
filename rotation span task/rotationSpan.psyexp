        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((sequenceDataset.error_speed[experimentalBlock.thisN] === 0)) {&amp;#10;    if ((sequenceDataset.face_forward[experimentalBlock.thisN] === 1)) {&amp;#10;        sequenceDataset.Accuracy_letter[experimentalBlock.thisN] = yes.numClicks;&amp;#10;    } else {&amp;#10;        sequenceDataset.Accuracy_letter[experimentalBlock.thisN] = no.numClicks;&amp;#10;    }&amp;#10;} else {&amp;#10;    sequenceDataset.Accuracy_letter[experimentalBlock.thisN] = 0;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.Accuracy_letter&quot;, sequenceDataset.Accuracy_letter[experimentalBlock.thisN]);&amp;#10;if ((sequenceDataset.face_forward[experimentalBlock.thisN] === 1)) {&amp;#10;    sequenceDataset.error_letter[experimentalBlock.thisN] = no.numClicks;&amp;#10;} else {&amp;#10;    sequenceDataset.error_letter[experimentalBlock.thisN] = yes.numClicks;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myExp.error_letter&quot;, sequenceDataset.error_letter[experimentalBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# accuracy sym (overall accuracy, this will be 0 if participants take too long to respond)&amp;#10;if sequenceDataset.error_speed[experimentalBlock.thisN] == 0:&amp;#10;    if sequenceDataset.face_forward[experimentalBlock.thisN] == 1:&amp;#10;        sequenceDataset.Accuracy_letter[experimentalBlock.thisN]             = yes.numClicks &amp;#10;    else:&amp;#10;        sequenceDataset.Accuracy_letter[experimentalBlock.thisN]             = no.numClicks&amp;#10;else:&amp;#10;    sequenceDataset.Accuracy_letter[experimentalBlock.thisN] = 0&amp;#10;thisExp.addData('myExp.Accuracy_letter',         sequenceDataset.Accuracy_letter[experimentalBlock.thisN])&amp;#10;&amp;#10;# judgement error (pure error from judgement, don't care whether pt take too long to judge the grid)&amp;#10;if sequenceDataset.face_forward[experimentalBlock.thisN] == 1:&amp;#10;    sequenceDataset.error_letter[experimentalBlock.thisN] = no.numClicks&amp;#10;else:&amp;#10;    sequenceDataset.error_letter[experimentalBlock.thisN] = yes.numClicks&amp;#10;thisExp.addData('myExp.error_letter', sequenceDataset.error_letter[experimentalBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
