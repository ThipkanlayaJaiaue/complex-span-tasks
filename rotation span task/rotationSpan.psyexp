        <Param val="import * as np from 'numpy';&amp;#10;if ((practLetterResponse_yes.isClicked || practLetterResponse_no.isClicked)) {&amp;#10;    if ((sequenceDataset_practLetter.face_forward[practiceLetterBlock.thisN] === 1)) {&amp;#10;        sequenceDataset_practLetter.Accuracy[practiceLetterBlock.thisN] = Number.parseInt(practLetterResponse_yes.isClicked);&amp;#10;    } else {&amp;#10;        sequenceDataset_practLetter.Accuracy[practiceLetterBlock.thisN] = Number.parseInt(practLetterResponse_no.isClicked);&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPractLetter.Accuracy&quot;, sequenceDataset_practLetter.Accuracy[practiceLetterBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
