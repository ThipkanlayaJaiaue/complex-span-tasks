        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="import * as np from 'numpy';&amp;#10;PracticeArrow_allTrials_num = sequenceDataset_practFinal.Accuracy_arrow.length;&amp;#10;PracticeArrow_correctTrials_num = np.sum(sequenceDataset_practFinal.Accuracy_arrow);&amp;#10;PracticeFinalLetter_allTrials_num = sequenceDataset_practFinal.Accuracy_letter.length;&amp;#10;PracticeFinalLetter_correctTrials_num = np.sum(sequenceDataset_practFinal.Accuracy_letter);&amp;#10;PracticeFinalLetter_speedError_num = np.sum(sequenceDataset_practFinal.error_speed);&amp;#10;PracticeFinalLetter_accuracyError_num = np.sum(sequenceDataset_practFinal.error_letter);&amp;#10;msg = `${PracticeFinalLetter_correctTrials_num} of ${PracticeFinalLetter_allTrials_num} correct judgments&amp;#10;(${PracticeFinalLetter_speedError_num} delayed judgments)&amp;#10;&amp;#10;${PracticeArrow_correctTrials_num} of ${PracticeArrow_allTrials_num}`&amp;#10;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="import numpy as np&amp;#10;&amp;#10;# number of arrow trials&amp;#10;PracticeArrow_allTrials_num = len(sequenceDataset_practFinal.Accuracy_arrow) &amp;#10;# number of arrow with correct answer&amp;#10;PracticeArrow_correctTrials_num = np.sum(sequenceDataset_practFinal.Accuracy_arrow)&amp;#10;&amp;#10;# number of letter trials&amp;#10;PracticeFinalLetter_allTrials_num = len(sequenceDataset_practFinal.Accuracy_letter) &amp;#10;# number of correct letter trials &amp;#10;PracticeFinalLetter_correctTrials_num = np.sum(sequenceDataset_practFinal.Accuracy_letter)&amp;#10;&amp;#10;# total speed_error&amp;#10;PracticeFinalLetter_speedError_num = np.sum(sequenceDataset_practFinal.error_speed)&amp;#10;# total letter_error&amp;#10;PracticeFinalLetter_accuracyError_num = np.sum(sequenceDataset_practFinal.error_letter)&amp;#10;&amp;#10;# message for feedback&amp;#10;msg = &quot;%i of %i correct judgments\n(%i delayed judgments)\n\n%i of %i correct recalls&quot; %(PracticeFinalLetter_correctTrials_num, PracticeFinalLetter_allTrials_num, PracticeFinalLetter_speedError_num, PracticeArrow_correctTrials_num, PracticeArrow_allTrials_num)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
