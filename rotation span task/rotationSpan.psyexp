      <CodeComponent name="expRecall_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="expRecall_next.setAutoDraw(False)&amp;#10;&amp;#10;# Variable to keep track of the last clicked button&amp;#10;last_clicked_button = None&amp;#10;&amp;#10;# copy the arrow name to this line for future accuracy check&amp;#10;thisExp.addData('myExp.expectedArrow',           sequenceDataset.arrow_figName[experimentalRecallBlock.thisN])&amp;#10;&amp;#10;&amp;#10;# number of sym trials&amp;#10;ExpLetter_allTrials_num = len(sequenceDataset.Accuracy_letter) &amp;#10;# number of correct sym trials &amp;#10;ExpLetter_correctTrials_num = np.sum(sequenceDataset.Accuracy_letter)&amp;#10;# percentage of correct sym trials&amp;#10;ExpLetter_correctTrials_pct = 100 * ExpLetter_correctTrials_num/ExpLetter_allTrials_num&amp;#10;# total speed_error&amp;#10;ExpLetter_speedError_num = np.sum(sequenceDataset.error_speed)&amp;#10;#total sym_error&amp;#10;ExpLetter_accuracyError_num = np.sum(sequenceDataset.error_letter)&amp;#10;&amp;#10;# message for feedback&amp;#10;msg = &quot;%.2f%% correct judgments&quot; %(ExpLetter_correctTrials_pct)&amp;#10;  &amp;#10;# color of feedback&amp;#10;if ExpLetter_correctTrials_pct&gt;=85:&amp;#10;    fb_col = 'green'     # if accuracy is at least the value above&amp;#10;else:&amp;#10;    fb_col = 'red'" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="buttons = [short_0_final_2, short_45_final_2, short_90_final_2, short_135_final_2, short_180_final_2, short_225_final_2, short_270_final_2, short_315_final_2, long_0_final_2, long_45_final_2, long_90_final_2, long_135_final_2, long_180_final_2, long_225_final_2, long_270_final_2, long_315_final_2]&amp;#10;&amp;#10;# check if any button is clicked&amp;#10;for button in buttons:&amp;#10;    if mouse_4.isPressedIn(button):&amp;#10;        if last_clicked_button is not None: # if there is previous clicked button&amp;#10;            last_clicked_button.color = 'white'  # reset the previous button to white&amp;#10;        &amp;#10;        button.color = 'red'  # set the current clicked button to red&amp;#10;        last_clicked_button = button  # update the last clicked button&amp;#10;        expRecall_next.setAutoDraw(True) # 'next' button pop up      &amp;#10;        &amp;#10;        last_clicked_button_name = &quot;_&quot;.join(last_clicked_button.name.split(&quot;_&quot;)[:2])&amp;#10;        thisExp.addData('myExp.selected_arrow', last_clicked_button_name)&amp;#10;        sequenceDataset.Accuracy_arrow[experimentalRecallBlock.thisN]             = int(sequenceDataset.arrow_figName[experimentalRecallBlock.thisN] == last_clicked_button_name)&amp;#10;        thisExp.addData('myExp.Accuracy_arrow',      sequenceDataset.Accuracy_arrow[experimentalRecallBlock.thisN])&amp;#10;        break&amp;#10;&amp;#10;if expRecall_next.isClicked:&amp;#10;    for last_clicked_button in buttons:&amp;#10;        last_clicked_button.color = 'white' # reset them all to white after click 'next'&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="buttons = [short_0_final_2, short_45_final_2, short_90_final_2, short_135_final_2, short_180_final_2, short_225_final_2, short_270_final_2, short_315_final_2, long_0_final_2, long_45_final_2, long_90_final_2, long_135_final_2, long_180_final_2, long_225_final_2, long_270_final_2, long_315_final_2];&amp;#10;for (var button, _pj_c = 0, _pj_a = buttons, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    button = _pj_a[_pj_c];&amp;#10;    if (mouse_4.isPressedIn(button)) {&amp;#10;        if ((last_clicked_button !== null)) {&amp;#10;            last_clicked_button.color = &quot;white&quot;;&amp;#10;        }&amp;#10;        button.color = &quot;red&quot;;&amp;#10;        last_clicked_button = button;&amp;#10;        expRecall_next.setAutoDraw(true);&amp;#10;        last_clicked_button_name = last_clicked_button.name.split(&quot;_&quot;).slice(0, 2).join(&quot;_&quot;);&amp;#10;        psychoJS.experiment.addData(&quot;myExp.selected_arrow&quot;, last_clicked_button_name);&amp;#10;        sequenceDataset.Accuracy_arrow[experimentalRecallBlock.thisN] = Number.parseInt((sequenceDataset.arrow_figName[experimentalRecallBlock.thisN] === last_clicked_button_name));&amp;#10;        psychoJS.experiment.addData(&quot;myExp.Accuracy_arrow&quot;, sequenceDataset.Accuracy_arrow[experimentalRecallBlock.thisN]);&amp;#10;        break;&amp;#10;    }&amp;#10;}&amp;#10;if (expRecall_next.isClicked) {&amp;#10;    for (var last_clicked_button, _pj_c = 0, _pj_a = buttons, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        last_clicked_button = _pj_a[_pj_c];&amp;#10;        last_clicked_button.color = &quot;white&quot;;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expRecall_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
