        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="import * as np from 'numpy';&amp;#10;import * as pd from 'pandas';&amp;#10;trialAll_num = setSizes_data.current_setSize[AllExperimentalBlocks.thisN];&amp;#10;red_number = np.arange(1, 17);&amp;#10;np.random.shuffle(red_number);&amp;#10;trial = np.arange(1, (trialAll_num + 1));&amp;#10;red_selection = red_number.slice(0, trialAll_num);&amp;#10;figName = [];&amp;#10;for (var num, _pj_c = 0, _pj_a = red_selection, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    num = _pj_a[_pj_c];&amp;#10;    figName.push((&quot;red_square&quot; + num.toString()));&amp;#10;}&amp;#10;redSquare_Dataset = new pd.DataFrame({&quot;trial&quot;: trial, &quot;figName&quot;: figName, &quot;redSquare_num&quot;: red_selection});&amp;#10;redSquare_Dataset;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="import numpy as np&amp;#10;import pandas as pd&amp;#10;&amp;#10;trialAll_num = setSizes_data.current_setSize[AllExperimentalBlocks.thisN]&amp;#10;red_number = np.arange(1, 17)  # red square choices from 1 to 16&amp;#10;&amp;#10;# shuffle the choices&amp;#10;np.random.shuffle(red_number)&amp;#10;&amp;#10;# create variable 'trial'&amp;#10;trial = np.arange(1, trialAll_num + 1)&amp;#10;&amp;#10;# select the choices from the shuffled numbers&amp;#10;red_selection = red_number[:trialAll_num]&amp;#10;&amp;#10;# create figure name&amp;#10;figName = []&amp;#10;for num in red_selection:&amp;#10;    figName.append('red_square' + str(num))&amp;#10;&amp;#10;# create a DataFrame&amp;#10;redSquare_Dataset = pd.DataFrame({&amp;#10;    'trial': trial,&amp;#10;    'figName': figName,&amp;#10;    'redSquare_num': red_selection&amp;#10;})&amp;#10;&amp;#10;redSquare_Dataset" valType="extendedCode" updates="constant" name="End Routine"/>
