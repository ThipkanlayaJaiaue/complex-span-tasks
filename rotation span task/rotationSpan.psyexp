        <Param val="import numpy as np&amp;#10;import pandas as pd&amp;#10;&amp;#10;trialAll_num = setSizes_practFinal.current_setSize[AllPracticeBlocks.thisN]  # number of trials (must be even)&amp;#10;letter = [&quot;F&quot;, &quot;G&quot;, &quot;J&quot;, &quot;R&quot;]&amp;#10;category = [&quot;ff&quot;, &quot;mr&quot;]&amp;#10;rotation = [0, 45, 90, 135, 180, 225, 270, 315]&amp;#10;arrow = [&quot;short&quot;, &quot;long&quot;]&amp;#10;&amp;#10;# create variable 'trial'&amp;#10;trial = 1 + np.arange(0, trialAll_num)&amp;#10;&amp;#10;figName = np.empty(trialAll_num, dtype=&quot;&lt;U10&quot;)&amp;#10;face_forward = np.empty(trialAll_num, dtype=int)&amp;#10;arrow_figName = np.empty(trialAll_num, dtype=&quot;&lt;U10&quot;)&amp;#10;&amp;#10;# create all possible figure and arrow names&amp;#10;all_fig_names = [f&quot;{l}_{r}_{c}&quot; for l in letter for r in rotation for c in category]&amp;#10;all_arrow_names = [f&quot;{a}_{r}&quot; for a in arrow for r in rotation]&amp;#10;&amp;#10;&amp;#10;# create a while loop to run until conditions are met&amp;#10;while True:&amp;#10;    # shuffle the possible figure and arrow names&amp;#10;    np.random.shuffle(all_fig_names)&amp;#10;    np.random.shuffle(all_arrow_names)&amp;#10;    &amp;#10;    # used the first-trialAll_num index from each list&amp;#10;    used_fig_names = all_fig_names[:trialAll_num]&amp;#10;    used_arrow_names = all_arrow_names[:trialAll_num]&amp;#10;&amp;#10;    for trialIdx in range(trialAll_num):&amp;#10;        figName[trialIdx] = used_fig_names[trialIdx]&amp;#10;        face_forward[trialIdx] = 1 if &quot;ff&quot; in figName[trialIdx] else 0&amp;#10;        arrow_figName[trialIdx] = used_arrow_names[trialIdx]&amp;#10;&amp;#10;    # create variables to calculate face forward/mirror reversed figure proportions&amp;#10;    ff_proportion = np.sum(face_forward == 1) / trialAll_num&amp;#10;    mr_proportion = np.sum(face_forward == 0) / trialAll_num&amp;#10;&amp;#10;    # check if both proportions are at least 30%&amp;#10;    if ff_proportion &gt;= 0.30 and mr_proportion &gt;= 0.30:&amp;#10;        break  # exit the loop when the condition are met&amp;#10;&amp;#10;# create a DataFrame for the sequence dataset&amp;#10;sequenceDataset_practFinal = pd.DataFrame({&amp;#10;    'trial': trial,&amp;#10;    'face_forward': face_forward,&amp;#10;    'figName': figName,&amp;#10;    'arrow_figName': arrow_figName,&amp;#10;    'expectedArrow': np.nan,&amp;#10;    'observedResponse': np.nan,&amp;#10;    'Accuracy_letter': np.nan,&amp;#10;    'Accuracy_arrow': np.nan,&amp;#10;    'error_letter': np.nan,&amp;#10;    'error_speed': np.nan,&amp;#10;    'trialDuration': np.nan&amp;#10;})&amp;#10;&amp;#10;sequenceDataset_practFinal" valType="extendedCode" updates="constant" name="End Routine"/>
