        <Param val="import * as random from 'random';&amp;#10;import * as np from 'numpy';&amp;#10;import * as pd from 'pandas';&amp;#10;setSizes_pool = [2, 2, 3];&amp;#10;Math.random.shuffle(setSizes_pool);&amp;#10;setSizes_num = setSizes_pool.length;&amp;#10;setSizes_block_num = np.arange(1, (setSizes_num + 1));&amp;#10;setSizes_practArrow = new pd.DataFrame({&quot;setSizes_block_num&quot;: setSizes_block_num, &quot;current_setSize&quot;: setSizes_pool});&amp;#10;setSizes_practArrow;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
