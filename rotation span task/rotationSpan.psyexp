      <CodeComponent name="practFinalResponse_addData" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((sequenceDataset_practFinal.error_speed[practiceBlock.thisN] === 0)) {&amp;#10;    if ((sequenceDataset_practFinal.face_forward[practiceBlock.thisN] === 1)) {&amp;#10;        sequenceDataset_practFinal.Accuracy_letter[practiceBlock.thisN] = practFinalResponse_yes.numClicks;&amp;#10;    } else {&amp;#10;        sequenceDataset_practFinal.Accuracy_letter[practiceBlock.thisN] = practFinalResponse_no.numClicks;&amp;#10;    }&amp;#10;} else {&amp;#10;    sequenceDataset_practFinal.Accuracy_letter[practiceBlock.thisN] = 0;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPractFinal.Accuracy_sym&quot;, sequenceDataset_practFinal.Accuracy_letter[practiceBlock.thisN]);&amp;#10;if ((sequenceDataset_practFinal.face_forward[practiceBlock.thisN] === 1)) {&amp;#10;    sequenceDataset_practFinal.error_letter[practiceBlock.thisN] = practFinalResponse_no.numClicks;&amp;#10;} else {&amp;#10;    sequenceDataset_practFinal.error_letter[practiceBlock.thisN] = practFinalResponse_yes.numClicks;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPractFinal.error_letter&quot;, sequenceDataset_practFinal.error_letter[practiceBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# accuracy sym (overall accuracy, this will be 0 if participants take too long to respond)&amp;#10;if sequenceDataset_practFinal.error_speed[practiceBlock.thisN] == 0:&amp;#10;    if sequenceDataset_practFinal.face_forward[practiceBlock.thisN] == 1:&amp;#10;        sequenceDataset_practFinal.Accuracy_letter[practiceBlock.thisN]             = practFinalResponse_yes.numClicks &amp;#10;    else:&amp;#10;        sequenceDataset_practFinal.Accuracy_letter[practiceBlock.thisN]             = practFinalResponse_no.numClicks&amp;#10;else:&amp;#10;    sequenceDataset_practFinal.Accuracy_letter[practiceBlock.thisN] = 0&amp;#10;thisExp.addData('myPractFinal.Accuracy_sym',         sequenceDataset_practFinal.Accuracy_letter[practiceBlock.thisN])&amp;#10;&amp;#10;# judgement error (pure error from judgement, don't care whether pt take too long to judge the letter)&amp;#10;if sequenceDataset_practFinal.face_forward[practiceBlock.thisN] == 1:&amp;#10;    sequenceDataset_practFinal.error_letter[practiceBlock.thisN] = practFinalResponse_no.numClicks&amp;#10;else:&amp;#10;    sequenceDataset_practFinal.error_letter[practiceBlock.thisN] = practFinalResponse_yes.numClicks &amp;#10;thisExp.addData('myPractFinal.error_letter', sequenceDataset_practFinal.error_letter[practiceBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="practFinalResponse_addData" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
