      <CodeComponent name="practLetterFbBlock_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="import numpy as np&amp;#10;&amp;#10;# duration of practiceSymTrial&amp;#10;avgPracticeLetter_trialDuration = np.mean(sequenceDataset_practLetter.trialDuration)&amp;#10;stdPracticeLetter_trialDuration = np.std(sequenceDataset_practLetter.trialDuration)&amp;#10;&amp;#10;# time limit for sym trial&amp;#10;Letter_timeLimit = avgPracticeLetter_trialDuration + (2.5 * stdPracticeLetter_trialDuration)&amp;#10;&amp;#10;# number of trials&amp;#10;PracticeLetter_allTrials_num = len(sequenceDataset_practLetter.Accuracy) &amp;#10;&amp;#10;# number of trials with correct answer&amp;#10;PracticeLetter_correctTrials_num = np.sum(sequenceDataset_practLetter.Accuracy)&amp;#10;&amp;#10;# percentage of trials with correct answer&amp;#10;PracticeLetter_correctTrials_pct= 100*PracticeLetter_correctTrials_num/ PracticeLetter_allTrials_num&amp;#10;&amp;#10;&amp;#10;# message for feedback&amp;#10;if PracticeLetter_correctTrials_num&gt; 0:&amp;#10;    msg = &quot;%i of %i correct responses \n%.2f%% correct \n average RT = %.2f s &quot; %(PracticeLetter_correctTrials_num, PracticeLetter_allTrials_num, PracticeLetter_correctTrials_pct, avgPracticeLetter_trialDuration)&amp;#10;else:&amp;#10;    msg = &quot;%i of %i correct responses \n%.2f%% correct&quot; %(PracticeLetter_correctTrials_num, PracticeLetter_allTrials_num, PracticeLetter_correctTrials_pct)&amp;#10;    &amp;#10;    &amp;#10;# color of feedback&amp;#10;if PracticeLetter_correctTrials_pct&gt;=85:&amp;#10;    fb_col = 'green'     # if accuracy is at least the value above&amp;#10;else:&amp;#10;    fb_col = 'red'" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((PracticeLetter_correctTrials_pct &gt;= 85)) {&amp;#10;    practiceLetterBlockCutOff.finished = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if PracticeLetter_correctTrials_pct &gt;= 85:&amp;#10;    practiceLetterBlockCutOff.finished = True" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="practLetterFbBlock_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
