      <CodeComponent name="practArrowRecall_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="practArrowRecall_next.setAutoDraw(false);&amp;#10;last_clicked_button = null;&amp;#10;psychoJS.experiment.addData(&quot;myPractArrow.expectedArrow&quot;, sequenceDataset_practArrow.arrow_figName[practiceArrowRecallBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="practArrowRecall_next.setAutoDraw(False)&amp;#10;&amp;#10;# Variable to keep track of the last clicked button&amp;#10;last_clicked_button = None&amp;#10;&amp;#10;# copy the red square to this line for future accuracy check&amp;#10;thisExp.addData('myPractArrow.expectedArrow',           sequenceDataset_practArrow.arrow_figName[practiceArrowRecallBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="buttons = [short_0, short_45, short_90, short_135, short_180, short_225, short_270, short_315, long_0, long_45, long_90, long_135, long_180, long_225, long_270, long_315]&amp;#10;&amp;#10;# check if any button is clicked&amp;#10;for button in buttons:&amp;#10;    if mouse.isPressedIn(button):&amp;#10;        if last_clicked_button is not None: # if there is previous clicked button&amp;#10;            last_clicked_button.color = 'white'  # reset the previous button to white&amp;#10;        &amp;#10;        button.color = 'red'  # set the current clicked button to red&amp;#10;        last_clicked_button = button  # update the last clicked button&amp;#10;        practArrowRecall_next.setAutoDraw(True) # 'next' button pop up      &amp;#10;        thisExp.addData('myPractArrow.selected_arrow', last_clicked_button.name)&amp;#10;        sequenceDataset_practArrow.Accuracy[practiceArrowRecallBlock.thisN]             = int(sequenceDataset_practArrow.arrow_figName[practiceArrowRecallBlock.thisN] == last_clicked_button.name)&amp;#10;        thisExp.addData('myPractArrow.Accuracy',      sequenceDataset_practArrow.Accuracy[practiceArrowRecallBlock.thisN])&amp;#10;        break&amp;#10;&amp;#10;if practArrowRecall_next.isClicked:&amp;#10;    for last_clicked_button in buttons:&amp;#10;        last_clicked_button.color = 'white' # reset them all to white after click 'next'&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="buttons = [short_0, short_45, short_90, short_135, short_180, short_225, short_270, short_315, long_0, long_45, long_90, long_135, long_180, long_225, long_270, long_315];&amp;#10;for (var button, _pj_c = 0, _pj_a = buttons, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    button = _pj_a[_pj_c];&amp;#10;    if (mouse.isPressedIn(button)) {&amp;#10;        if ((last_clicked_button !== null)) {&amp;#10;            last_clicked_button.color = &quot;white&quot;;&amp;#10;        }&amp;#10;        button.color = &quot;red&quot;;&amp;#10;        last_clicked_button = button;&amp;#10;        practArrowRecall_next.setAutoDraw(true);&amp;#10;        psychoJS.experiment.addData(&quot;myPractArrow.selected_arrow&quot;, last_clicked_button.name);&amp;#10;        sequenceDataset_practArrow.Accuracy[practiceArrowRecallBlock.thisN] = Number.parseInt((sequenceDataset_practArrow.arrow_figName[practiceArrowRecallBlock.thisN] === last_clicked_button.name));&amp;#10;        psychoJS.experiment.addData(&quot;myPractArrow.Accuracy&quot;, sequenceDataset_practArrow.Accuracy[practiceArrowRecallBlock.thisN]);&amp;#10;        break;&amp;#10;    }&amp;#10;}&amp;#10;if (practArrowRecall_next.isClicked) {&amp;#10;    for (var last_clicked_button, _pj_c = 0, _pj_a = buttons, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        last_clicked_button = _pj_a[_pj_c];&amp;#10;        last_clicked_button.color = &quot;white&quot;;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="practArrowRecall_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <MouseComponent name="mouse" plugin="None">
        <Param val="short_0, short_45, short_90, short_135, short_180, short_225, short_270, short_315, long_0, long_45, long_90, long_135, long_180, long_225, long_270, long_315" valType="list" updates="constant" name="clickable"/>
        <Param val="" valType="list" updates="constant" name="correctAns"/>
